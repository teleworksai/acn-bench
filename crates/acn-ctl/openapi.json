                  "$ref": "#/components/schemas/Refusal"
                }
              }
            },
            "description": "The body is over 1 MiB"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            },
            "description": "Wrong content type"
          },
          "421": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            },
            "description": "The Host is not this server's loopback address"
          },
          "500": {
