{
  "components": {
    "schemas": {
      "Answer": {
        "properties": {
          "code": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "type": "object"
      },
      "Empty": {
        "additionalProperties": false,
        "type": "object"
      },
      "Endpoint": {
        "additionalProperties": false,
        "properties": {
          "backend": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "backend",
          "url"
        ],
        "type": "object"
      },
      "Submit": {
        "additionalProperties": false,
        "description": "A run request (SPEC 070 §2, CTL-10).",
        "properties": {
          "arm": {
            "type": "string"
          },
          "backend": {
            "type": "string"
          },
          "hypothesis": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "harness",
              "generator"
            ]
          },
          "mode": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "opt": {
            "additionalProperties": false,
            "properties": {
              "endpoint": {
                "type": "string"
              },
              "endpoint_name": {
                "type": "string"
              },
              "max_retries": {
                "minimum": 0,
                "type": "integer"
              },
              "request_timeout_ms": {
                "minimum": 0,
                "type": "integer"
              },
              "retry_base_ms": {
                "minimum": 0,
                "type": "integer"
              },
              "stall_threshold_ms": {
                "minimum": 0,
                "type": "number"
              }
            },
            "type": "object"
          },
          "replicates": {
            "minimum": 1,
            "type": "integer"
          },
          "scenario": {
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string"
                  }
                },
                "required": [
                  "path"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "hash": {
                    "type": "string"
                  }
                },
                "required": [
                  "hash"
                ],
                "type": "object"
              }
            ]
          },
          "seed": {
            "pattern": "^(0|[1-9][0-9]*)$",
            "type": "string"
          },
          "sheet": {
            "type": "string"
          },
          "vary": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "workload": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "scenario"
        ],
        "type": "object"
      }
    }
  },
