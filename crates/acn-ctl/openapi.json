{
  "components": {
    "schemas": {
      "Bundle": {
        "description": "A bundle, verified (CTL-22).",
        "properties": {
          "bundle_digest": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "files": {
            "items": {
              "properties": {
                "hash": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "size": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "path",
                "size",
                "hash"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "manifest": {
            "description": "The bundle's manifest (SPEC 010).",
            "type": "object"
          },
          "ok": {
            "const": true
          },
          "run_id": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "ok",
          "run_id",
          "bundle_digest",
          "manifest",
          "files"
        ],
        "type": "object"
      },
      "Empty": {
        "additionalProperties": false,
        "description": "`{}`; an empty body is taken as `{}`.",
        "type": "object"
      },
      "Endpoint": {
        "additionalProperties": false,
        "properties": {
          "backend": {
            "enum": [
              "mockllm",
              "openai",
              "vllm",
              "sglang",
              "anthropic"
            ]
          },
          "url": {
            "description": "A base URL without credentials, or `acn-mock://loopback` for `mockllm` (HAR-26).",
            "type": "string"
          }
        },
        "required": [
          "backend",
          "url"
        ],
        "type": "object"
      },
      "Endpoints": {
        "description": "The registered endpoints (CTL-30).",
        "properties": {
          "endpoints": {
            "items": {
              "properties": {
                "backend": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "backend",
                "url"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "ok": {
            "const": true
          }
        },
        "required": [
          "ok",
          "endpoints"
        ],
        "type": "object"
      },
      "Named": {
        "description": "The endpoint registered (CTL-30).",
        "properties": {
          "name": {
            "type": "string"
          },
          "ok": {
            "const": true
          }
        },
        "required": [
          "ok",
          "name"
        ],
        "type": "object"
      },
      "Ok": {
        "description": "Done.",
        "properties": {
          "ok": {
            "const": true
          }
        },
        "required": [
          "ok"
        ],
        "type": "object"
      },
      "Refusal": {
        "description": "Every refusal (CTL-2).",
        "properties": {
          "code": {
            "description": "A stable machine-readable reason.",
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "ok": {
            "const": false
          }
        },
        "required": [
          "ok",
          "code",
          "error"
        ],
        "type": "object"
      },
      "Run": {
        "description": "A request and its status (CTL-21).",
        "properties": {
          "ok": {
            "const": true
          },
          "request": {
            "description": "The resolved request, as `request.json` holds it (CTL-11).",
            "type": "object"
          },
          "request_id": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          }
        },
        "required": [
          "ok",
          "request_id",
          "request",
          "status"
        ],
        "type": "object"
      },
      "Runs": {
        "description": "Every request, in submission order (CTL-21).",
        "properties": {
          "ok": {
            "const": true
          },
          "runs": {
            "items": {
              "properties": {
                "request_id": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                "state": {
                  "enum": [
                    "queued",
                    "running",
                    "done",
                    "failed"
                  ]
                }
              },
              "required": [
                "request_id",
                "state"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "ok",
          "runs"
        ],
        "type": "object"
      },
      "Scenario": {
        "description": "A stored scenario (CTL-20).",
        "properties": {
          "hash": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "ok": {
            "const": true
          },
          "toml": {
            "type": "string"
          }
        },
        "required": [
          "ok",
          "hash",
          "name",
          "toml"
        ],
        "type": "object"
      },
      "Status": {
        "description": "A request's status (CTL-21). `run_id` is set from `running` on; `bundle_digest` and `reused` when `done`; `code` and `error` when `failed`. Times are RFC 3339 UTC.",
        "properties": {
          "bundle_digest": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "ended_at": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "reused": {
            "type": "boolean"
          },
          "run_id": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "seq": {
            "minimum": 0,
            "type": "integer"
          },
          "started_at": {
            "type": "string"
          },
          "state": {
            "enum": [
              "queued",
              "running",
              "done",
              "failed"
            ]
          },
          "submitted_at": {
            "type": "string"
          }
        },
        "required": [
          "seq",
          "state",
          "submitted_at"
        ],
        "type": "object"
      },
      "Stored": {
        "description": "The scenario stored (CTL-20).",
        "properties": {
          "hash": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "ok": {
            "const": true
          }
        },
        "required": [
          "ok",
          "hash",
          "name"
        ],
        "type": "object"
      },
      "Submit": {
        "additionalProperties": false,
        "description": "A run request (SPEC 070 §2, CTL-10). A `harness` request names `workload`, `backend` and `model` and no `sheet`; a `generator` request names `sheet` and none of those three. Exactly one of `hypothesis` and `seed`. Paths are relative to the workspace root.",
        "properties": {
          "arm": {
            "enum": [
              "treatment",
              "control"
            ]
          },
          "backend": {
            "description": "harness.",
            "enum": [
              "mockllm",
              "openai",
              "vllm",
              "sglang",
              "anthropic"
            ]
          },
          "hypothesis": {
            "description": "The hypothesis file; the seed is derived from it (HYP-9).",
            "type": "string"
          },
          "kind": {
            "enum": [
              "harness",
              "generator"
            ]
          },
          "mode": {
            "enum": [
              "sim",
              "live",
              "netem"
            ]
          },
          "model": {
            "description": "harness: the model, or the mock profile.",
            "type": "string"
          },
          "opt": {
            "additionalProperties": false,
            "description": "Run options, as the CLI's flags; an absent one takes the CLI's default. At most one of `endpoint` and `endpoint_name`.",
            "properties": {
              "endpoint": {
                "description": "A base URL (HAR-25).",
                "type": "string"
              },
              "endpoint_name": {
                "description": "A registered endpoint (CTL-30).",
                "pattern": "^[a-z0-9-]{1,64}$",
                "type": "string"
              },
              "max_retries": {
                "minimum": 0,
                "type": "integer"
              },
              "request_timeout_ms": {
                "minimum": 0,
                "type": "integer"
              },
              "retry_base_ms": {
                "minimum": 0,
                "type": "integer"
              },
              "stall_threshold_ms": {
                "minimum": 0,
                "type": "number"
              }
            },
            "type": "object"
          },
          "replicates": {
            "minimum": 1,
            "type": "integer"
          },
          "retry": {
            "description": "Queue a failed request again (CTL-13).",
            "type": "boolean"
          },
          "scenario": {
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "description": "A scenario file in the workspace.",
                    "type": "string"
                  }
                },
                "required": [
                  "path"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "hash": {
                    "description": "A stored scenario (CTL-20).",
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  }
                },
                "required": [
                  "hash"
                ],
                "type": "object"
              }
            ]
          },
          "seed": {
            "description": "Decimal, at most 2^63 − 1.",
            "pattern": "^(0|[1-9][0-9]{0,18})$",
            "type": "string"
          },
          "sheet": {
            "description": "generator: the sheet (GEN-1).",
            "type": "string"
          },
          "vary": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "`name: value`, once per varied parameter.",
            "type": "object"
          },
          "workload": {
            "description": "harness: the workload file.",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "mode",
          "arm",
          "replicates"
        ],
        "type": "object"
      },
      "Submitted": {
        "description": "The request: 202 when new, 200 when it was already known (CTL-21).",
        "properties": {
          "ok": {
            "const": true
          },
          "request_id": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "state": {
            "enum": [
              "queued",
              "running",
              "done",
              "failed"
            ]
          }
        },
        "required": [
          "ok",
          "request_id",
          "state"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "The acn-bench control plane (SPEC 070).",
    "title": "acn-ctl",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/bundles/{run_id}": {
      "get": {
        "operationId": "get_bundle",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Bundle"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            },
            "description": "A malformed request or id"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            },
            "description": "Unknown"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            },
            "description": "A conflict"
          },
          "421": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            },
            "description": "The Host is not this server's loopback address"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            },
            "description": "An internal failure"
          }
        },
        "summary": "A bundle, verified: its manifest and files (CTL-22)."
      }
    },
    "/v1/bundles/{run_id}/files/{path}": {
      "get": {
        "operationId": "get_bundle_file",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              },
              "application/octet-stream": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              },
              "application/vnd.apache.parquet": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            },
            "description": "A malformed request or id"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            },
            "description": "Unknown"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            },
            "description": "A conflict"
          },
          "421": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            },
            "description": "The Host is not this server's loopback address"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            },
            "description": "An internal failure"
          }
        },
        "summary": "One file the manifest lists, after a hash check (CTL-23)."
      }
    },
    "/v1/endpoints": {
      "get": {
        "operationId": "list_endpoints",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Endpoints"
                }
              }
            },
            "description": "OK"
          },
          "421": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            },
            "description": "The Host is not this server's loopback address"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refusal"
                }
              }
            },
            "description": "An internal failure"
          }
        },
        "summary": "The registered endpoints (CTL-30)."
      }
    },
