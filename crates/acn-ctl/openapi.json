    },
    "/v1/openapi.json": {
      "get": {
        "operationId": "openapi",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "This document.",
                  "type": "object"
                }
              }
            },
            "description": "OK"
          },
          "421": {
            "content": {
              "application/json": {
                "schema": {
